{
  "name": "docsaathi",
  "version": "0.1.0",
  "description": "DocSaathi: find and book Indian doctors by voice on Alexa+. A self-hosted MCP server that connects Alexa+ to India's UHI doctor network.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "npm run build && tsx src/server/index.ts",
    "build": "tsx scripts/build.ts",
    "dev": "tsx watch src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:demo": "npm run build && tsx scripts/smoke-demo.ts",
    "smoke:oauth": "tsx scripts/smoke-oauth.ts",
    "eval": "tsx scripts/eval.ts",
    "check:records": "npm run build && tsx scripts/records-check.ts",
    "eval:bedrock": "tsx scripts/eval.ts bedrock new",
    "check:ui": "npm run build && tsx scripts/ui-check.ts",
    "check:aws": "tsx scripts/check-aws.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.35.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-crypto/sha256-js": "^4.0.0",
    "@aws-sdk/client-polly": "^3.1152.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@smithy/signature-v4": "^3.1.2",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
