# Copy this file to .env and fill in what you have. Everything is optional:
# without keys, DocSaathi runs fully offline in demo mode.

# Web server
PORT=3000
SANDBOX_PORT=3001

# Where the demo family lives (used for "near me" and travel time).
# With a Google Maps key this address is geocoded; otherwise the lat/lng below is used.
HOME_ADDRESS=Shivajinagar, Pune, Maharashtra
HOME_LAT=18.5308
HOME_LNG=73.8475

# Test on a phone: run `ngrok http 3000` and put its hostname here (comma separated for several).
# Only people with the link can reach it; stop ngrok when you are done.
PUBLIC_HOSTS=

# Account linking (OAuth 2.1, how Alexa+ gets a family's permission). See README "Account linking".
# The https address Alexa+ reaches DocSaathi at. It is the OAuth issuer, and <PUBLIC_URL>/mcp is the MCP
# resource (it must match the add-on manifest exactly). Empty = the address of each request.
PUBLIC_URL=
# true = only OAuth tokens open /mcp (the demo family token stops working). Use it on any public server.
REQUIRE_AUTH=false
# The Alexa+ add-on's OAuth client. Empty secret = one is made on first start and kept in data/alexa-client.json.
ALEXA_CLIENT_ID=docsaathi-alexa
ALEXA_CLIENT_SECRET=
# Alexa's redirect URIs for the add-on, comma separated (Alexa+ Developer Hub, or shown by
# `alexa-ai configure-account-linking`).
ALEXA_REDIRECT_URIS=
# The demo family's PIN for linking (with Papa's test mobile number 00000 11111).
FAMILY_LINK_PIN=1234

# Google Maps web-service key (optional). Enables real nearby clinics ("call to book")
# and real travel times. Needs: Geocoding API, Places API (legacy), Distance Matrix API.
GOOGLE_MAPS_API_KEY=

# UHI network. Default: the local test network that ships with this project.
# Point these at a real UHI gateway/registry when you have NHA sandbox access.
UHI_GATEWAY_URL=
UHI_SUBSCRIBER_ID=docsaathi-eua
UHI_CALLBACK_BASE_URL=

# Who understands what the family says:
#   demo    = built-in rules. No key needed. This is the default.
#   groq    = an AI model on Groq (free key from https://console.groq.com). Understands any phrasing.
#             What is said, and the family's first names and ages, are sent to Groq.
#             The rules still guard emergencies and "nothing is booked until you say yes",
#             and they take over by themselves when the free limit is reached.
#   bedrock = Claude on Amazon Bedrock (needs the AWS key below). The same rules guard it, and when
#             Bedrock cannot answer, Groq (if it has a key) and then the rules answer instead.
#             What is said, and the family's first names and ages, are sent to Amazon Bedrock.
BRAIN=demo
GROQ_API_KEY=
# Optional: models to try, in order (default: openai/gpt-oss-120b,qwen/qwen3.8-27b)
GROQ_MODELS=

# Amazon Web Services (see docs/AWS_SETUP.md). Keep these secret, never commit them.
# ap-south-1 = Mumbai. If `npm run check:aws` says a model or voice is not there, try us-east-1.
AWS_REGION=ap-south-1
# An IAM access key works for both the brain (Bedrock) and the voice (Polly). Recommended.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or a Bedrock API key: works for the brain only (not for the Polly voice).
AWS_BEARER_TOKEN_BEDROCK=
# Claude models on Bedrock, tried in order (default below): Haiku 5.5 is the newest and cheapest;
# Haiku 4.5 is open to every AWS account, so it answers while Haiku 5.5 access is pending.
BEDROCK_MODELS=anthropic.claude-haiku-5-5,anthropic.claude-haiku-4-5
# low = quickest replies (right for voice). medium / high = more careful, slower.
BEDROCK_EFFORT=low
# off = no thinking step (fastest). adaptive = the model thinks when it wants (slower).
BEDROCK_THINKING=off
# Safety for the bill: after this many AI requests in a day, Groq or the rules answer.
# (Counted in data/aws-usage.json, so a restart does not reset it. The day starts 5:30 AM India time.)
BEDROCK_DAILY_LIMIT=500

# Alexa's voice: browser = the computer's own voices (free). polly = Amazon Polly (natural voice,
# needs the IAM access key above). When Polly fails or is slow, the browser voice speaks instead.
VOICE=browser
# Kajal speaks Indian English and Hindi.
POLLY_VOICE=Kajal
POLLY_ENGINE=neural
# Empty = AWS_REGION.
POLLY_REGION=
# Safety for the bill: after this many new characters in a day, the browser voice speaks.
POLLY_DAILY_CHARS=60000
